# ── URLs (all three must be reachable from the browser) ─────────
# Public URL of the deployment.
MAIN_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
# Compiled into the frontend bundle at build time — recreate the container
# after changing this, or the browser keeps calling the old address.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api

# ── Secrets ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# ── Behaviour ───────────────────────────────────────────────────
# Required for the self-hosted build.
IS_GENERAL=true
# local writes uploads to the /uploads volume.
STORAGE_PROVIDER=local
# Runs the cron worker. Without this, scheduled posts never publish.
RUN_CRON=true
# Set to true once your own account exists.
# DISABLE_REGISTRATION=true

# ── Database (compose builds DATABASE_URL / REDIS_URL from these) ─
POSTGRES_USER=postiz
POSTGRES_PASSWORD=change_me_too
POSTGRES_DB=postiz

# POSTIZ_PORT=5000
